#!/bin/sh
### BEGIN INIT INFO
# Provides:          companion
# Required-Start:    $remote_fs $syslog
# Required-Stop:     $remote_fs $syslog
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: Companion service
### END INIT INFO

PATH="/usr/local/sbin:/usr/local/bin:/sbin:/bin:/usr/sbin:/usr/bin"
SERVICE="companion"
SCRIPT_PATH="/etc/init.d/${SERVICE}"
BASE_DIR="/home/bticino/cfg/extra/companion"
BIN_PATH="${BASE_DIR}/companion"
STAGED_BIN_PATH="${BASE_DIR}/companion.new"
PREVIOUS_BIN_PATH="${BASE_DIR}/companion.previous"
PIDFILE="/var/run/${SERVICE}.pid"
WATCHDOG_PIDFILE="/var/run/${SERVICE}-watchdog.pid"
WATCHDOG_ENABLE_FILE="/var/run/${SERVICE}-watchdog.enabled"
LIFECYCLE_LOCK_DIR="/var/run/${SERVICE}-lifecycle.lock"
LIFECYCLE_LOCK_PIDFILE="${LIFECYCLE_LOCK_DIR}/pid"
LOGFILE="/tmp/${SERVICE}.log"
HEALTH_URL="http://127.0.0.1:8080/api/v3/health"
HEALTH_TIMEOUT_SECONDS=15
START_ATTEMPTS=3
RETRY_DELAY_SECONDS=2
WATCHDOG_INTERVAL_SECONDS=15
WATCHDOG_MAX_BACKOFF_SECONDS=120
BINARY_WAIT_SECONDS="${COMPANION_BINARY_WAIT_SECONDS:-60}"
LAN_IP_WAIT_SECONDS=30

if [ -f /etc/init.d/functions ]; then
	# shellcheck source=/dev/null
	. /etc/init.d/functions
fi

tcp_listen_ports() { echo "8080 80 8554 51826"; }
udp_listen_ports() { echo "5353 8555"; }

ensure_firewall_rule() {
	proto="$1"
	port="$2"
	if /usr/sbin/iptables -C INPUT -p "${proto}" --dport "${port}" -j ACCEPT >/dev/null 2>&1; then return; fi
	/usr/sbin/iptables -I INPUT 1 -p "${proto}" --dport "${port}" -j ACCEPT >/dev/null 2>&1 || true
}

ensure_firewall() {
	[ -x /usr/sbin/iptables ] || return 0
	for port in $(tcp_listen_ports); do ensure_firewall_rule tcp "${port}"; done
	for port in $(udp_listen_ports); do ensure_firewall_rule udp "${port}"; done
}

remove_firewall_rule() {
	proto="$1"
	port="$2"
	while /usr/sbin/iptables -C INPUT -p "${proto}" --dport "${port}" -j ACCEPT >/dev/null 2>&1; do
		/usr/sbin/iptables -D INPUT -p "${proto}" --dport "${port}" -j ACCEPT >/dev/null 2>&1 || break
	done
}

remove_firewall() {
	[ -x /usr/sbin/iptables ] || return 0
	for port in $(tcp_listen_ports); do remove_firewall_rule tcp "${port}"; done
	for port in $(udp_listen_ports); do remove_firewall_rule udp "${port}"; done
}

device_lan_ip() {
	for ifc in wlan0 eth0; do
		addr="$(ip -4 addr show "${ifc}" 2>/dev/null | awk '/inet /{print $2; exit}' | cut -d/ -f1)"
		[ -n "${addr}" ] || continue
		printf '%s' "${addr}"
		return 0
	done
	return 1
}

wait_for_lan_ip() {
	attempt=0
	while [ "${attempt}" -lt "${LAN_IP_WAIT_SECONDS}" ]; do
		device_lan_ip >/dev/null 2>&1 && return 0
		sleep 1
		attempt=$((attempt + 1))
	done
	return 1
}

flexisip_listening() {
	netstat -lnt 2>/dev/null | grep -q '127.0.0.1:5060'
}

# ensure_flexisip brings up the device's on-demand SIP proxy if it is not
# already listening. flexisip must be up *before* the BTicino stack registers,
# so the device registers c100x to it and the local SIP camera path works
# without the cloud. flexisip does not touch the hardware watchdog, so safe.
ensure_flexisip() {
	flexisip_listening && return 0
	[ -x /etc/init.d/flexisipsh ] || return 0
	ip="$(device_lan_ip)" || return 0
	/etc/init.d/flexisipsh start "${ip}" >/dev/null 2>&1 || true
}

process_running() {
	status -p "${PIDFILE}" -b "${BIN_PATH}" "${BIN_PATH}" >/dev/null 2>&1
}

companion_healthy() {
	process_running && health_check
}

script_process_running() {
	pid="$1"
	[ -n "${pid}" ] && [ -d "/proc/${pid}" ] || return 1
	cmdline="$(tr '\0' ' ' < "/proc/${pid}/cmdline" 2>/dev/null || true)"
	case "${cmdline}" in *"${SERVICE}"*) return 0 ;; *) return 1 ;; esac
}

watchdog_running() {
	[ -f "${WATCHDOG_PIDFILE}" ] || return 1
	watchdog_pid="$(cat "${WATCHDOG_PIDFILE}" 2>/dev/null || true)"
	script_process_running "${watchdog_pid}" || return 1
	case "${cmdline}" in *"${SCRIPT_PATH}"*"_watchdog"*) return 0 ;; *) return 1 ;; esac
}

lock_owner_running() {
	[ -f "${LIFECYCLE_LOCK_PIDFILE}" ] || return 1
	lock_pid="$(cat "${LIFECYCLE_LOCK_PIDFILE}" 2>/dev/null || true)"
	script_process_running "${lock_pid}"
}

acquire_lifecycle_lock() {
	lock_attempt=0
	while ! mkdir "${LIFECYCLE_LOCK_DIR}" 2>/dev/null; do
		if ! lock_owner_running; then
			rm -f "${LIFECYCLE_LOCK_PIDFILE}"
			rmdir "${LIFECYCLE_LOCK_DIR}" 2>/dev/null || true
			continue
		fi
		lock_attempt=$((lock_attempt + 1))
		[ "${lock_attempt}" -lt "${HEALTH_TIMEOUT_SECONDS}" ] || return 1
		sleep 1
	done
	echo "$$" > "${LIFECYCLE_LOCK_PIDFILE}"
}

release_lifecycle_lock() {
	rm -f "${LIFECYCLE_LOCK_PIDFILE}"
	rmdir "${LIFECYCLE_LOCK_DIR}" 2>/dev/null || true
}

with_lifecycle_lock() {
	action="$1"
	shift
	acquire_lifecycle_lock || return 1
	case "${action}" in
	start) start_companion "$@" ;;
	stop) stop_companion ;;
	recover) recover_companion ;;
	*) release_lifecycle_lock; return 1 ;;
	esac
	action_status=$?
	release_lifecycle_lock
	return "${action_status}"
}

cleanup_stale_pidfile() {
	[ -f "${PIDFILE}" ] || return 0
	process_running || rm -f "${PIDFILE}"
}

# The binary lives on the ${BASE_DIR} partition. At boot this script can run
# before that partition is mounted, so wait for it instead of giving up.
wait_for_binary() {
	attempt=0
	while [ "${attempt}" -lt "${BINARY_WAIT_SECONDS}" ]; do
		if [ -x "${BIN_PATH}" ] || [ -x "${STAGED_BIN_PATH}" ]; then return 0; fi
		sleep 1
		attempt=$((attempt + 1))
	done
	[ -x "${BIN_PATH}" ] || [ -x "${STAGED_BIN_PATH}" ]
}

activate_staged_binary() {
	[ -f "${STAGED_BIN_PATH}" ] || return 0
	[ -x "${STAGED_BIN_PATH}" ] || { echo "Staged companion binary is not executable" >&2; return 1; }
	if [ -e "${BIN_PATH}" ]; then
		ln -f "${BIN_PATH}" "${PREVIOUS_BIN_PATH}"
	fi
	mv -f "${STAGED_BIN_PATH}" "${BIN_PATH}"
	chmod 755 "${BIN_PATH}"
}

health_check() {
	/usr/bin/curl -fsS --max-time 3 "${HEALTH_URL}" >/dev/null 2>&1
}

wait_for_health() {
	attempt=0
	while [ "${attempt}" -lt "${HEALTH_TIMEOUT_SECONDS}" ]; do
		health_check && return 0
		sleep 1
		attempt=$((attempt + 1))
	done
	return 1
}

start_process() {
	/sbin/start-stop-daemon --start --quiet --oknodo --background --make-pidfile \
		--pidfile "${PIDFILE}" --exec "${BIN_PATH}" -- >>"${LOGFILE}" 2>&1
}

start_companion() {
	promote_staged="$1"
	cleanup_stale_pidfile
	if companion_healthy; then
		echo "${SERVICE} already running"
		return 0
	fi
	if process_running; then
		echo "${SERVICE} process is unhealthy; restarting" >&2
		stop_companion || return 1
	fi

	if [ "${promote_staged}" = "true" ]; then
		activate_staged_binary || return 1
	fi
	if [ ! -x "${BIN_PATH}" ]; then
		echo "Missing companion binary at ${BIN_PATH}" >&2
		return 1
	fi
	mkdir -p "$(dirname "${PIDFILE}")" || return 1
	: > "${LOGFILE}" || return 1
	ensure_firewall

	attempt=1
	while [ "${attempt}" -le "${START_ATTEMPTS}" ]; do
		start_process && wait_for_health && return 0
		echo "${SERVICE} failed health check (attempt ${attempt}/${START_ATTEMPTS})" >&2
		stop_companion || return 1
		attempt=$((attempt + 1))
		[ "${attempt}" -le "${START_ATTEMPTS}" ] && sleep "${RETRY_DELAY_SECONDS}"
	done
	return 1
}

stop_companion() {
	cleanup_stale_pidfile
	if process_running; then
		killproc -p "${PIDFILE}" -b "${BIN_PATH}" -d 5 "${BIN_PATH}" >/dev/null 2>&1 || return 1
	fi
	rm -f "${PIDFILE}"
	remove_firewall
}

start_watchdog() {
	: > "${WATCHDOG_ENABLE_FILE}" || return 1
	if watchdog_running; then
		return 0
	fi
	rm -f "${WATCHDOG_PIDFILE}"
	"${SCRIPT_PATH}" _watchdog >>"${LOGFILE}" 2>&1 &
	echo "$!" > "${WATCHDOG_PIDFILE}"
}

stop_watchdog() {
	rm -f "${WATCHDOG_ENABLE_FILE}"
	if watchdog_running; then
		kill -TERM "${watchdog_pid}" 2>/dev/null || return 1
		watchdog_wait=0
		while [ -d "/proc/${watchdog_pid}" ] && [ "${watchdog_wait}" -lt 5 ]; do
			sleep 1
			watchdog_wait=$((watchdog_wait + 1))
		done
		[ ! -d "/proc/${watchdog_pid}" ] || kill -KILL "${watchdog_pid}" 2>/dev/null || return 1
	fi
	rm -f "${WATCHDOG_PIDFILE}"
}

recover_companion() {
	[ -f "${WATCHDOG_ENABLE_FILE}" ] || return 0
	companion_healthy && return 0
	echo "${SERVICE} watchdog recovery requested" >&2
	stop_companion || return 1
	[ -f "${WATCHDOG_ENABLE_FILE}" ] || return 0
	start_companion false
}

do_watchdog() {
	trap 'rm -f "${WATCHDOG_PIDFILE}"; exit 0' INT TERM
	backoff="${WATCHDOG_INTERVAL_SECONDS}"
	while [ -f "${WATCHDOG_ENABLE_FILE}" ]; do
		ensure_flexisip
		if companion_healthy; then
			backoff="${WATCHDOG_INTERVAL_SECONDS}"
			sleep "${WATCHDOG_INTERVAL_SECONDS}"
			continue
		fi
		if with_lifecycle_lock recover; then
			backoff="${WATCHDOG_INTERVAL_SECONDS}"
			delay="${backoff}"
		else
			delay="${backoff}"
			echo "${SERVICE} watchdog recovery failed; retrying in ${delay}s" >&2
			[ "${backoff}" -ge "${WATCHDOG_MAX_BACKOFF_SECONDS}" ] || backoff=$((backoff * 2))
		fi
		sleep "${delay}"
	done
	rm -f "${WATCHDOG_PIDFILE}"
}

do_start() {
	wait_for_binary || echo "Companion binary still missing after ${BINARY_WAIT_SECONDS}s" >&2

	# Bring flexisip up before the BTicino stack registers (so c100x registers
	# locally and the SIP camera works without the cloud). Waiting for the LAN
	# IP also delays bt_daemon's start enough to win the race.
	wait_for_lan_ip || true
	ensure_flexisip

	with_lifecycle_lock start true
	start_status=$?

	# Start the watchdog even when the first attempt failed: it retries with
	# backoff, so a late partition mount no longer leaves the device
	# unsupervised for good.
	start_watchdog || return 1
	return "${start_status}"
}

do_stop() {
	stop_watchdog || return 1
	with_lifecycle_lock stop
}

do_status() {
	cleanup_stale_pidfile
	if ! process_running; then echo "${SERVICE} stopped"; return 3; fi
	if ! health_check; then echo "${SERVICE} running but unhealthy"; return 1; fi
	if ! watchdog_running; then echo "${SERVICE} running but watchdog stopped"; return 1; fi
	pid="$(cat "${PIDFILE}" 2>/dev/null || true)"
	echo "${SERVICE} running and healthy (pid ${pid}, watchdog ${watchdog_pid})"
}

case "${1:-}" in
start) do_start ;;
stop) do_stop ;;
restart|force-reload) do_stop; do_start ;;
status) do_status ;;
_watchdog) do_watchdog ;;
*) echo "Usage: $0 {start|stop|restart|force-reload|status}" >&2; exit 1 ;;
esac

exit 0
